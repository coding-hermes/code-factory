# github-app.example.env — copy to ~/.config/code-factory/github-app.env, chmod 600.
#
# This file holds POINTERS, never secrets: the private key stays where it is and this names
# the path. Nothing here is a credential, but the file is still 600 because it tells a reader
# where a credential lives.
#
# Get these values once, by hand, in a browser (no API can do it for you):
#   GITHUB_APP_ID              App settings -> About -> App ID
#   GITHUB_APP_INSTALLATION_ID organization Settings -> GitHub Apps -> Configure; the number
#                              in .../installations/<NUMBER>
#   GITHUB_APP_PRIVATE_KEY_FILE  App settings -> Private keys -> Generate a private key; the
#                              browser download is the ONLY copy GitHub will ever offer
#   GITHUB_APP_SLUG            the name in https://github.com/apps/<slug>
#
# Then: scripts/github-app-setup.sh --apply --slug <slug> --repo <org>/<repo> \
#         --app-id <n> --installation-id <n> --key-file <path>
# or write this file yourself and run: scripts/github-app-setup.sh --check
#
# Permissions the App must declare (Repository permissions):
#   Contents        Read and write   clone and push commits from a node
#   Pull requests   Read and write   open the PR a protected main requires
#   Metadata        Read only        mandatory for every App; resolves repo and installation
#
# The token this mints is valid for ONE HOUR. A node needs scripts/github-app-refresh.sh on a
# timer (every 20 minutes, --min-age 2400) or it silently loses push rights an hour after it
# was provisioned. See skills/code-factory-bunker/SKILL.md.

GITHUB_APP_ID=<app-id>
GITHUB_APP_INSTALLATION_ID=<installation-id>
GITHUB_APP_PRIVATE_KEY_FILE=~/.config/code-factory/github-app.private-key.pem
GITHUB_APP_SLUG=<app-slug>
GITHUB_APP_REPO=<org>/<repo>
# where a minted token is written (mode 600, never committed)
GITHUB_APP_TOKEN_FILE=~/.config/code-factory/github.token
