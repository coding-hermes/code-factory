+def _tracked_paths(root: str):
+    """Repo-relative tracked paths, or None when root is not a git work tree (a fixture)."""
+    try:
+        out = subprocess.run(['git', '-C', root, 'ls-files', '-z'],
+                             capture_output=True, timeout=30)
+    except (OSError, subprocess.SubprocessError):
+        return None
+    if out.returncode != 0:
+        return None
+    return [p for p in out.stdout.decode('utf-8', 'replace').split('\0') if p]
+
+
+def shell_toolkit(root: str) -> tuple[int, str | None]:
+    """(tracked script count, gate) for a project that ships scripts instead of a manifest.
+
+    The question is what the project SHIPS, so an untracked scratch script does not count when
+    `root` is a work tree. A tree that is not under git (a fixture, an extracted tarball) has no
+    tracked set to consult and is counted from the filesystem instead.
+    """
+    files = _tracked_paths(root)
+    if files is None:
+        files = []
+        for d in SHELL_TOOLKIT_DIRS:
+            base = os.path.join(root, d)
+            if not os.path.isdir(base):
+                continue
+            for dirpath, dirnames, filenames in os.walk(base):
+                dirnames[:] = [x for x in dirnames
+                               if x not in ('.git', 'node_modules', '.venv')]
+                if dirpath[len(base):].count(os.sep) >= 2:
+                    dirnames[:] = []
+                    continue
+                files += [os.path.relpath(os.path.join(dirpath, f), root)
+                          for f in filenames if f.endswith('.sh')]
+    tracked = set(files)
+    scripts = {p for p in tracked
+               if p.endswith('.sh') and len(p.split('/')) <= 3
+               and p.split('/')[0] in SHELL_TOOLKIT_DIRS}
+    gate = SHELL_TOOLKIT_GATE if SHELL_TOOLKIT_GATE in tracked else None
+    return len(scripts), gate
+
