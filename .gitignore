# node state is per-machine, never committed
.node/
*.log
.env
.env.*
key*
*.key
.gitreins/tasks.yaml
.gitreins/config.yaml.bak
.gitreins/usage.jsonl
.gitreins/logs/
.gitreins/history/
.gitreins/qa-ledger.jsonl
.gitreins/worktrees.json
.gitreins/worktrees.lock
.gitreins/disposable.json
.gitreins/disposable.lock
.gitreins/tasks.yaml.lock
.gitreins/verdicts/
.gitreins/quality.json
# gitreins review state: per-machine cursor + finding fingerprints (a checkout that carried it
# across machines replayed another host's ACTIVE findings). Runtime state, never source.
.gitreins/review-state.json
.gitreins/review-state.lock
.coding-hermes/board/.lock

# Python bytecode, kept out of every checkout including nodes
__pycache__/
*.pyc
.vfs/
.gitreins/rescued-*/

# Foreman ownership claim — the panel loop holds the checkout while it writes.
.coding-hermes/panel.lock

# Hermetic toolchain caches and scratch trees: the test harnesses point XDG_CACHE_HOME and
# XDG_DATA_HOME at $HERE/.tmp (PERF-018 shares one JS toolchain cache across fixtures), so a
# single selftest run leaves thousands of untracked cache files. Producer output, never source.
.tmp/

# panel loop runtime state (rounds are transcripts; tracking them lets a checkout rewind
# the counter — it rewound 17 -> 12 and killed five rounds of work)
docs/handbook/_panel/

# per-tick foreman wave scratch (generated helpers + captured output; never reviewed)
waves/
