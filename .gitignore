# node state is per-machine, never committed
.node/
*.log
.env
.env.*
key*
*.key
.gitreins/tasks.yaml
.gitreins/config.yaml.bak
.gitreins/usage.jsonl
.gitreins/logs/
.gitreins/history/
.gitreins/qa-ledger.jsonl
.gitreins/worktrees.json
.gitreins/worktrees.lock
.gitreins/disposable.json
.gitreins/disposable.lock
.gitreins/tasks.yaml.lock
.gitreins/verdicts/
.gitreins/quality.json
.coding-hermes/board/.lock

# Python bytecode, kept out of every checkout including nodes
__pycache__/
*.pyc
.vfs/
.gitreins/rescued-*/

# Foreman ownership claim — the panel loop holds the checkout while it writes.
.coding-hermes/panel.lock

# panel loop runtime state (rounds are transcripts; tracking them lets a checkout rewind
# the counter — it rewound 17 -> 12 and killed five rounds of work)
docs/handbook/_panel/
