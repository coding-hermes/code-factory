  "verification_order": [
    "recompute response_body_digest from payload with the cf.crier.response-body.v1 tag",
    "recompute receipt_digest from receipt with the cf.crier.receipt.v1 tag",
    "compare receipt.response_body_digest to the recomputed payload digest",
    "verify the envelope signature over the transcript naming receipt_digest, response_body_digest, audience and transport",
    "compare audience to the receiving node id and generation",
    "only then accept the credential reference"
  ],
  "response_hash_rule": "the response hash never covers the embedded receipt or its digest",
  "negative_arms": [
    {
      "name": "payload mutated after the receipt was issued",
      "mutate": {
        "pointer": "/payload/result/expires_at"
      },
      "expected": {
        "accepted": false,
        "refusal": "DIGEST_MISMATCH",
        "detail": "recomputed response_body_digest differs from receipt.response_body_digest"
      }
    },
    {
      "name": "receipt linked to a different payload",
      "mutate": {
        "pointer": "/receipt/response_body_digest"
      },
      "expected": {
        "accepted": false,
        "refusal": "DIGEST_MISMATCH"
      }
    },
    {
      "name": "receipt digest included in its own domain",
      "mutate": {
        "pointer": "/receipt/receipt_digest",
        "value": "included"
      },
      "expected": {
        "accepted": false,
        "refusal": "CONTRACT_INVALID"
      }
    },
    {
      "name": "envelope replayed to another audience",
      "mutate": {
        "pointer": "/envelope/audience/node_id",
        "value": "node-2"
      },
      "expected": {
        "accepted": false,
        "refusal": "AUDIENCE_MISMATCH",
        "detail": "the signature transcript names the original audience"
      }
    },
    {
      "name": "request replay digest reused for a different message type",
      "mutate": {
        "pointer": "/request/replay_digest"
      },
      "value_hint": "H(\"custody.release\" || canonical body)",
      "expected": {
        "accepted": false,
        "refusal": "DIGEST_MISMATCH"
      }
    },
    {
      "name": "idempotency key inside the request digest domain",
      "mutate": {
        "pointer": "/request/request_digest",
        "op": "recompute-including-idempotency-key"
      },
      "expected": {
        "accepted": false,
        "refusal": "CONTRACT_INVALID",
        "detail": "the excluded-field list is normative; a digest computed with a different list is not comparable"
      }
    }
  ]
