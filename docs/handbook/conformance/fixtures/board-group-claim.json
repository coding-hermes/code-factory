  "negative_arms": [
    {
      "name": "group exceeds the bound",
      "mutate": {
        "pointer": "/group_claim/claims",
        "op": "repeat-to",
        "count": 257
      },
      "expected": {
        "accepted": false,
        "refusal": "INVALID_FIELD",
        "detail": "the bound is one value, declared once, by the schema"
      }
    },
    {
      "name": "duplicate claim",
      "mutate": {
        "pointer": "/group_claim/claims/1/task_id",
        "value": "CF-1"
      },
      "expected": {
        "accepted": false,
        "refusal": "INVALID_FIELD"
      }
    },
    {
      "name": "claims out of order",
      "mutate": {
        "pointer": "/group_claim/claims",
        "op": "reverse"
      },
      "expected": {
        "accepted": false,
        "refusal": "INVALID_FIELD",
        "detail": "ordering is created_seq ASC then id ASC; a reversed list is not the declared ordering"
      }
    },
    {
      "name": "abbreviated commit id",
      "mutate": {
        "pointer": "/group_claim/board_revision",
        "value": "1111111"
      },
      "expected": {
        "accepted": false,
        "refusal": "INVALID_FIELD",
        "detail": "a normal object id is 40 or 64 lowercase hex; an abbreviation or a flag is refused"
      }
    },
    {
      "name": "paraphrased ordering literal",
      "mutate": {
        "pointer": "/group_claim/ordering",
        "value": "created_seq ascending, then id"
      },
      "expected": {
        "accepted": false,
        "refusal": "INVALID_FIELD",
        "detail": "two orderings for one version is the defect; the literal is a single value"
      }
    },
    {
      "name": "precommit record naming a commit",
      "mutate": {
        "pointer": "/evidence_chain/0/subject/commit_oid",
        "value": "2222222222222222222222222222222222222222"
      },
      "expected": {
        "accepted": false,
        "refusal": "PHASE_INVALID",
        "detail": "staged evidence that names a commit is a different phase record, not a staged one"
      }
    },
    {
      "name": "publication re-labels accepted bytes from a later tip",
      "mutate": {
        "pointer": "/evidence_chain/3/subject/accepted_object/commit_oid",
