{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.coding-hermes.invalid/cf2a/1.0.0/schemas/cf2a.board-claim.schema.json",
  "$comment": "CF2A-01 pass-7 Wave 1 · canonical group claim (P7-05 surface, P7-06 evidence binding). The bound, the ordering and the object-id form are all schema-enforced, so a 257-member group, an out-of-order member list or an abbreviated object id cannot be represented at all.",
  "title": "cf.group-claim.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "claim_generation", "project_id", "claimant",
               "group", "ordering", "members", "board", "claimed_at_seq", "lease_expires_at"],
  "properties": {
    "schema_version": {"const": "cf.group-claim.v1"},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "claim_generation": {"type": "integer", "minimum": 1},
    "project_id": {"type": "string", "minLength": 1},
    "claimant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimant_id", "owner_fence"],
      "properties": {
        "claimant_id": {"type": "string", "minLength": 1},
        "owner_fence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_id", "epoch", "owner_id", "project_id"],
          "properties": {
            "authority_id": {"type": "string", "minLength": 1},
            "epoch": {"type": "integer", "minimum": 0},
            "owner_id": {"type": "string", "minLength": 1},
            "project_id": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_members", "min_members", "member_count"],
      "properties": {
        "max_members": {"type": "integer", "const": 256,
                        "description": "One bound, asserted by the schema. A wider group is a different record, not a larger claim."},
        "min_members": {"type": "integer", "minimum": 1, "maximum": 256},
        "member_count": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "direction", "comparison"],
      "properties": {
        "field": {"const": "task_id"},
        "direction": {"const": "ascending"},
        "comparison": {"const": "bytewise UTF-8"}
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "board_row_revision", "criterion_digest"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "board_row_revision": {"type": "integer", "minimum": 1},
          "criterion_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "base_oid", "marker_path"],
      "properties": {
        "ref": {"type": "string", "pattern": "^refs/"},
        "base_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$",
                     "description": "Normal object id only: 40 or 64 lowercase hex. Never abbreviated, never flagged."},
        "marker_path": {"type": "string", "minLength": 1}
      }
    },
    "claimed_at_seq": {"type": "integer", "minimum": 0},
    "lease_expires_at": {"type": "string", "format": "date-time"}
  }
}
