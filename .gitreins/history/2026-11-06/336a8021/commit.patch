++  no "D1b a refused --turn removed a sentinel"
++fi
++[ -e "$RUNID_HOME/.cache/cf-codex" ] && no "D1b a refused run created the turn cache root anyway" \
++  || ok "D1b a refused run created nothing under \$HOME/.cache"
