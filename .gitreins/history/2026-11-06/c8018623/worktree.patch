@@ -0,0 +1,347 @@
+#!/usr/bin/env python3
+"""fleet_ops_check.py — the operations census for the coding-hermes fleet.
+
+Why this exists
+---------------
+QA caught defects in what a project *does*. Nothing caught the operations around it: a service
+could ship with no health endpoint, no metrics, no restart policy and no deploy path and no lane
+would ever say so — it just quietly became the thing that pages nobody. This is the ops analogue
+of the QA sweep: derive what a project IS from evidence in its tree, then judge only the ops
+surfaces that kind of project needs.
+
+Design rules
+------------
+* **Derive the kind, never assume it.** A docs-only repo needs no k8s. A service needs health,
+  metrics, supervision and a deploy path. Getting this wrong is how an ops check becomes noise
+  nobody reads.
+* **Evidence or silence.** Every finding carries the file (or absence) it was derived from.
+* **Exit 0 when clean, 1 when a RUNNABLE project has a gap.** Lanes are silent when clean.
+
+Usage
+-----
+  fleet_ops_check.py                     # text report for the whole fleet
+  fleet_ops_check.py --json              # machine report
+  fleet_ops_check.py --project code-factory
+  fleet_ops_check.py --only-gaps         # suppress compliant projects
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import sqlite3
+import sys
+
+DB = os.path.expanduser('~/.hermes/coding-hermes/scheduler.db')
+ROLE_SUFFIXES = ('-foreman', '-qa', '-ops', '-pm', '-relsync', '-sync', '-releng',
+                 '-dogfood', '-docs', '-readme', '-review', '-perf')
+
+# Files whose presence proves a capability, and the capability they prove.
+CONTAINER = ('Dockerfile', 'docker-compose.yml', 'docker-compose.yaml', 'compose.yml',
+             'compose.yaml', 'Containerfile')
+ORCHESTRATION = ('k8s', 'kubernetes', 'deploy/k8s', 'helm', 'chart', 'Chart.yaml',
+                 'kustomization.yaml', 'manifests')
+SUPERVISION = ('deploy', 'deployment', 'systemd', 'contrib/systemd', 'ops', 'packaging')
+DEPLOY_DOC = ('DEPLOY.md', 'docs/deploy.md', 'docs/deployment.md', 'RUNBOOK.md',
+              'docs/runbook.md', 'OPERATIONS.md', 'docs/operations.md')
+BACKUP = ('backup', 'restore', 'snapshot')
+
+SERVER_PAT = re.compile(
+    r'(ListenAndServe|http\.Server\{|net/http.*Handler|FastAPI\(|Flask\(|'
+    r'app\.listen\(|createServer\(|express\(\)|uvicorn\.run|serve\(\))')
+STATEFUL_PAT = re.compile(r'(sqlite3|duckdb|postgres|psycopg|pgx|mysql|redis|bbolt|leveldb)')
+
+
+def project_family(name: str) -> str:
+    """Strip ROLE suffixes REPEATEDLY: `x-foreman-qa` -> `x`, not `x-foreman`.
+
+    A single strip left `wojons-mythos-foreman` standing as its own "project family", so the
+    census reported a docs project called `wojons-mythos-foreman` alongside the real one and
+    doubled every finding.
+    """
+    changed = True
+    while changed:
+        changed = False
+        for suf in sorted(ROLE_SUFFIXES, key=len, reverse=True):
+            if name.endswith(suf) and len(name) > len(suf):
+                name = name[: -len(suf)]
+                changed = True
+                break
+    return name
+
+
+def load_projects():
+    con = sqlite3.connect(f'file:{DB}?mode=ro', uri=True)
+    rows = con.execute(
+        'SELECT name, workdir, repo_url, enabled, namespace_id FROM projects'
+    ).fetchall()
+    con.close()
+    out = {}
+    for name, workdir, repo_url, enabled, ns in rows:
+        fam = project_family(name)
+        cur = out.get(fam)
+        # prefer an enabled row, then the one with a real workdir
+        score = (1 if enabled else 0, 1 if workdir else 0, len(name))
+        if cur is None or score > cur['_score']:
+            out[fam] = {'family': fam, 'workdir': workdir, 'repo_url': repo_url,
+                        'enabled': bool(enabled), 'namespace': ns, 'lanes': [],
+                        '_score': score}
+        out[fam]['lanes'].append(name)
+    con.close() if False else None
+    for v in out.values():
+        v.pop('_score', None)
+    return out
+
+
+def exists_any(root: str, names) -> str | None:
+    for n in names:
+        p = os.path.join(root, n)
+        if os.path.exists(p):
+            return n
+    return None
+
+
+def rel_hits(root: str, names, limit: int = 12) -> list[str]:
+    """Shallow, bounded search: `names` matched as path components anywhere under root."""
+    hits, root = [], os.path.realpath(root)
+    if not os.path.isdir(root):
+        return hits
+    for dirpath, dirnames, filenames in os.walk(root):
+        depth = dirpath[len(root):].count(os.sep)
+        if depth >= 3:
+            dirnames[:] = []
+        dirnames[:] = [d for d in dirnames
+                       if d not in ('.git', 'node_modules', 'venv', '.venv', 'dist',
+                                    'build', '__pycache__', 'target', '.next')]
+        for n in names:
+            if n in filenames or n in dirnames:
+                p = os.path.relpath(os.path.join(dirpath, n), root)
+                if p not in hits:
+                    hits.append(p)
+                if len(hits) >= limit:
+                    return sorted(hits)
+    return sorted(hits)
+
+
+def grep_files(root: str, pattern, exts=('.go', '.py', '.ts', '.js', '.rs'),
+               limit=2000, max_bytes=400_000) -> bool:
+    """Bounded content scan: True on first match. Never reads a huge file whole."""
+    seen = 0
+    for dirpath, dirnames, filenames in os.walk(root):
+        depth = dirpath[len(root):].count(os.sep)
+        if depth >= 4:
+            dirnames[:] = []
+        dirnames[:] = [d for d in dirnames
+                       if d not in ('.git', 'node_modules', 'venv', '.venv', 'dist',
+                                    'build', '__pycache__', 'target')]
+        for f in filenames:
+            if not f.endswith(exts):
+                continue
+            seen += 1
+            if seen > limit:
+                return False
+            p = os.path.join(dirpath, f)
+            try:
+                if os.path.getsize(p) > max_bytes:
+                    continue
+                with open(p, errors='replace') as fh:
+                    if pattern.search(fh.read()):
+                        return True
+            except OSError:
+                continue
+    return False
+
+
+def classify(root: str, docs_only: bool) -> tuple[str, dict]:
+    """(kind, evidence). kind in service | cli | library | docs | unknown."""
+    ev = {}
+    container = exists_any(root, CONTAINER) or (rel_hits(root, CONTAINER, 1) or [None])[0]
+    orch = rel_hits(root, ORCHESTRATION, 3)
+    sup = rel_hits(root, SUPERVISION, 3)
+    serv = grep_files(root, SERVER_PAT)
+    ev.update(container=container, orchestration=orch[:3], supervision=sup[:3],
+              server_entrypoint=serv)
+
+    has_go = os.path.exists(os.path.join(root, 'go.mod'))
+    has_py = any(os.path.exists(os.path.join(root, f))
+                 for f in ('pyproject.toml', 'setup.py', 'requirements.txt'))
+    has_js = os.path.exists(os.path.join(root, 'package.json'))
+    has_manifest = has_go or has_py or has_js
+
+    if docs_only or not has_manifest:
+        return ('docs' if docs_only else 'unknown'), ev
+    if container or orch or serv:
+        return 'service', ev
+    if has_go and os.path.isdir(os.path.join(root, 'cmd')):
+        return 'cli', ev
+    return 'library', ev
+
+
+def ops_gaps(kind: str, root: str, ev: dict) -> list[dict]:
+    """Findings for a project, restricted to what its KIND actually needs."""
+    gaps = []
+
+    def add(key, detail, severity='P2'):
+        gaps.append({'check': key, 'detail': detail, 'severity': severity})
+
+    if kind in ('service', 'cli', 'library'):
+        if not exists_any(root, DEPLOY_DOC):
+            add('deploy-doc', 'no DEPLOY/RUNBOOK/OPERATIONS doc — the deploy path is tribal',
+                'P2' if kind == 'service' else 'P3')
+
+    if kind == 'service':
+        if not ev.get('server_entrypoint'):
+            add('health', 'no health/readiness endpoint found in the entrypoint', 'P1')
+        if not grep_files(root, re.compile(r'(prometheus|/metrics|otel|opentelemetry|statsd)',
+                                           re.I)):
+            add('metrics', 'no metrics instrumentation (prometheus/otel/statsd)', 'P1')
+        if not ev.get('container'):
+            add('container', 'service with no Dockerfile/compose', 'P2')
+        if not ev.get('supervision'):
+            add('supervision', 'no systemd unit / deploy dir — restart policy undefined', 'P2')
+        if not ev.get('orchestration') and not ev.get('supervision'):
+            add('scheduling', 'no orchestrator and no supervisor: nothing restarts it', 'P2')
+        # Stateful means the project OWNS a store, not that it imports a db client — a service
+        # that talks to someone else's postgres has nothing of its own to back up. Evidence:
+        # a db/data file in the tree, or migrations/schema, or a compose service for a datastore.
+        owns_store = bool(rel_hits(root, ('migrations', 'schema.sql', 'init.sql'), 2)) or \
+            any(f.endswith(('.db', '.duckdb', '.sqlite', '.sqlite3'))
+                for f in rel_hits(root, ('data.db', 'app.db', 'store.db', 'state.db'), 3))
+        if owns_store and not rel_hits(root, BACKUP, 2):
+            add('backup', 'owns a datastore with no backup/restore path', 'P1')
+
+    if kind in ('service', 'library') and not rel_hits(root, ('.github',), 1):
+        add('ci', 'no CI pipeline in the repo — nothing gates a merge', 'P3')
+    return gaps
+
+
+def annotate_alignment(info: dict) -> list[dict]:
+    """Lane-family alignment: an active project should own an -ops lane.
+
+    Reported as ONE fleet-level rollup (see `--alignment`), never as a per-project P2 — 72
+    "no -ops lane" rows would bury the actual ops-surface findings the day this lane family is
+    first introduced, which is exactly when the signal matters most.
+    """
+    if not info['enabled']:
+        return []
+    if any(l.endswith('-ops') for l in info['lanes']):
+        return []
+    return [{'check': 'lane-ops', 'detail': 'no -ops lane — operations run unwatched',
+             'severity': 'P3'}]
+
+
+def resolve_workdir(info: dict) -> str:
+    """The directory an ops census should actually read.
+
+    A lane row's `workdir` is often a stand-in directory (a board holder), while the real repo is
+    named by `repo_url` as `local:/path`. Standing in a docs-only directory made ten running
+    services classify as `docs` and would have hidden every container/metrics gap they have.
+    """
+    wd = info.get('workdir') or ''
+    repo = info.get('repo_url') or ''
+    if repo.startswith('local:'):
+        cand = repo[len('local:'):]
+        if os.path.isdir(cand) and os.path.exists(os.path.join(cand, '.git')):
+            return cand
+    if wd and os.path.isdir(wd) and wd.rstrip('/') != '/tmp':
+        return wd
+    if repo.startswith('local:') and os.path.isdir(repo[len('local:'):]):
+        return repo[len('local:'):]
+    return wd
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--json', action='store_true')
+    ap.add_argument('--project')
+    ap.add_argument('--only-gaps', action='store_true')
+    ap.add_argument('--alignment', action='store_true',
+                    help='also list the families with no -ops lane (rollup only by default)')
+    ap.add_argument('--limit', type=int, default=0)
+    a = ap.parse_args()
+
+    fams = load_projects()
+    # Probe/scratch projects are not projects: they are fixtures a test left behind and they
+    # would otherwise carry a permanent "workdir does not exist" finding.
+    fams = {k: v for k, v in fams.items()
+            if not k.startswith('zz-') and (v.get('workdir') or '').rstrip('/') != '/tmp'
+            and not (v.get('workdir') or '').startswith('/tmp/')}
+    for v in fams.values():
+        v['workdir'] = resolve_workdir(v)
+    if a.project:
+        fams = {k: v for k, v in fams.items() if k == a.project}
+
+    report, flagged = [], 0
+    for fam, info in sorted(fams.items()):
+        wd = info.get('workdir') or ''
+        if not wd or not os.path.isdir(wd):
+            report.append({'family': fam, 'kind': 'unresolved', 'workdir': wd,
+                           'gaps': [{'check': 'workdir', 'severity': 'P2',
+                                     'detail': f'workdir does not exist: {wd}'}],
+                           'lanes': info['lanes'], 'evidence': {}})
+            flagged += 1
+            continue
+        docs_only = (not any(os.path.exists(os.path.join(wd, f))
+                             for f in ('go.mod', 'package.json', 'pyproject.toml',
+                                       'setup.py', 'Cargo.toml', 'requirements.txt')))
+        kind, ev = classify(wd, docs_only)
+        gaps = ops_gaps(kind, wd, ev)
+        if info['enabled']:
+            gaps += annotate_alignment(info)
+        entry = {'family': fam, 'kind': kind, 'workdir': wd, 'gaps': gaps,
+                 'lanes': info['lanes'], 'evidence': ev}
+        report.append(entry)
+        if gaps:
+            flagged += 1
+
+    if a.json:
+        print(json.dumps(report, indent=1, default=str))
+    else:
+        kinds, by_check = {}, {}
+        for r in report:
+            kinds[r['kind']] = kinds.get(r['kind'], 0) + 1
+            for g in r['gaps']:
+                by_check[g['check']] = by_check.get(g['check'], 0) + 1
+        print('OPS CENSUS  %d project families  %s' % (
+            len(report), '  '.join(f'{k}={v}' for k, v in sorted(kinds.items()))))
+        print('\nfindings by check:')
+        for k, v in sorted(by_check.items(), key=lambda kv: -kv[1]):
+            print('   %-13s %d' % (k, v))
+
+        no_ops = [r['family'] for r in report
+                  if any(g['check'] == 'lane-ops' for g in r['gaps'])]
+        if no_ops:
+            print('\nlanes: %d famil%s have no -ops lane%s' % (
+                len(no_ops), 'y' if len(no_ops) == 1 else 'ies',
+                ':' if a.alignment else ' (pass --alignment to list them)'))
+            if a.alignment:
+                for f in no_ops:
+                    print('   ' + f)
+
+        # The per-project list is the actionable half: everything above P3, workdirs that do not
+        # resolve, and runnable projects with an ops surface gap. A clean project stays silent.
+        print('\nprojects needing work (P1/P2):')
+        shown = 0
+        for r in sorted(report, key=lambda r: (-sum(1 for g in r['gaps']
+                                                    if g['severity'] in ('P1', 'P2')),
+                                               r['family'])):
+            hard = [g for g in r['gaps'] if g['severity'] in ('P1', 'P2')]
+            if not hard:
+                continue
+            if a.only_gaps and not hard:
+                continue
+            print('\n%-26s %-9s %s' % (r['family'][:26], r['kind'],
+                                       ', '.join(r['lanes'])[:58]))
+            for g in hard:
+                print('   %-3s [%-11s] %s' % (g['severity'], g['check'], g['detail']))
+            shown += 1
+            if a.limit and shown >= a.limit:
+                print('\n... stopped at --limit %d' % a.limit)
+                break
+        print('\nflagged %d of %d families (P1/P2 shown above)' % (flagged, len(report)))
+    return 1 if flagged else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
