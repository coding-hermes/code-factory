+        || { bad "turn_home" "cannot create the turn cache root $cache_root"; exit 1; }
+      turn_home=$(umask 077; mktemp -d "$cache_root/run.XXXXXXXX") \
+        || { turn_home=""; bad "turn_home" "cannot create a turn directory under $cache_root"; exit 1; }
       {
