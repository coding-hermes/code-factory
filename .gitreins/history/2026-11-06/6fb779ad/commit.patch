+    [ "${FIXTURE_INFO_FAIL:-0}" = 0 ] || { echo "agent ${2:-}: no such agent" >&2; exit 1; }
+    ;;
+  spawn|cp|exec) printf '%s\n' "$*" >> "${FIXTURE_LOG:?}" ;;
+  *) echo 'unexpected bunker command' >&2; exit 99 ;;
