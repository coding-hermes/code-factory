CommitDate: Fri Nov 6 12:54:17 2026 -0500

    fix(github-app-refresh): a FAIL row aborts the credential write (CF-320)
    
    Local mode printed `FAIL mode` for a token file at mode 644 and then rewrote
    ~/.git-credentials with that same token, exited 0, and printed a PASS refresh row:
    under `set -uo pipefail` (no -e) the `[ "$mode" = "600" ] || bad ...` line was a
    remark, not a verdict.
    
    The mode gate now exits non-zero before the credential store is touched, so a
    rejected token cannot be installed by the run that rejected it.
    
    "Refreshed" is also no longer decided by the minter's stdout: the token file's
    mtime and content digest are read before and after the mint, unchanged is a no-op
    and changed is a refresh. The `GITHUB APP TOKEN: SKIP` substring stays as
    informational output and a disagreement between it and the re-read is named.
    
    tests/selftest.sh gains one labelled block at the end of section 6 (no new
    numbered section, so the arm census stays 55) with three arms, each asserting
    named rows: an insecure mint (non-zero exit, one `FAIL mode` row, no
    `PASS refresh` row, credential store byte-identical), a two-hour-old token
    (mtime advanced, digest changed), and a fresh token whose minter reports a skip
    (no-op, both files byte-identical).
---
 scripts/github-app-refresh.sh | 39 ++++++++++++++++---
 tests/selftest.sh             | 90 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 124 insertions(+), 5 deletions(-)

diff --git a/scripts/github-app-refresh.sh b/scripts/github-app-refresh.sh
index 55cda3a..0b5d83f 100755
--- a/scripts/github-app-refresh.sh
+++ b/scripts/github-app-refresh.sh
@@ -76,8 +76,8 @@ life_left() {
 }
 
 # mint_local <dest> — fills MINT_ROWS (the minter's own named rows, which carry no secret) and
-# MINT_SKIPPED, so the caller can tell "a fresh token was written" from "the token was still
-# valid": a refresh that reports work it did not do is the same lie as a vacuous PASS.
+# MINT_SKIPPED, the minter's own claim. That claim is informational only: the caller decides
+# "refreshed" from a re-read of the file (file_state below), never from a stdout substring.
 MINT_ROWS=""
 MINT_SKIPPED=0
 mint_local() {
@@ -89,17 +89,46 @@ mint_local() {
   return "$rc"
 }
 
+# file_state <path> -> "<mtime-epoch> <sha256|->", read from the filesystem.
+# "Refreshed" is a fact about the file, never a sentence the minter printed: a stdout substring
+# is an assertion, and a PASS row paid for an assertion is the same lie as a vacuous green.
+file_state() {
+  local f="$1" m d
+  m=$(stat -c %Y "$f" 2>/dev/null || echo '-')
+  if [ -f "$f" ]; then
+    d=$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1)
+  fi
+  printf '%s %s' "$m" "${d:--}"
+}
+
 if [ "$LOCAL" -eq 1 ] || [ "$NODE" = "" ]; then
   say_q "github-app-refresh — local: $TOKEN_FILE (min-age ${MIN_AGE}s)"
   if [ "$DRY" -eq 1 ]; then note "dry run: no mint, no write"; exit 0; fi
+  before=$(file_state "$TOKEN_FILE")
   mint_local "$TOKEN_FILE" || { bad "refresh" "could not mint into $TOKEN_FILE — the existing token keeps its remaining life"; exit 1; }
-  if [ "$MINT_SKIPPED" -eq 1 ]; then
+  after=$(file_state "$TOKEN_FILE")
+  # The minter's own PASS/SKIP line is informational; the two reads above are the authority, and
+  # a disagreement between them is named rather than hidden behind either side's sentence.
+  if [ "$after" = "$before" ] && [ "$MINT_SKIPPED" -eq 0 ]; then
+    note "minter reported a mint, but $TOKEN_FILE was not rewritten"
+  elif [ "$after" != "$before" ] && [ "$MINT_SKIPPED" -eq 1 ]; then
+    note "minter reported a skip, but $TOKEN_FILE was rewritten"
+  fi
+  if [ "$after" = "$before" ]; then
+    [ -f "$TOKEN_FILE" ] || { bad "token_file" "$TOKEN_FILE is still absent after a mint that reported success"; exit 1; }
     left=$(life_left "$TOKEN_FILE")
-    ok "refresh" "(no-op) $TOKEN_FILE is still valid, ~${left}s left; nothing rewritten"
+    ok "refresh" "(no-op) $TOKEN_FILE was not rewritten (mtime and content unchanged), ~${left}s left; nothing rewritten"
     exit 0
   fi
+  # CF-320: a FAIL row is a verdict, not a remark. An insecure token file must stop the run
+  # BEFORE the credential store is rewritten — printing FAIL and then writing anyway leaves the
+  # store holding the very token the row just rejected.
   mode=$(stat -c %a "$TOKEN_FILE" 2>/dev/null || echo '?')
-  [ "$mode" = "600" ] || bad "mode" "$TOKEN_FILE is mode $mode, expected 600"
+  if [ "$mode" != "600" ]; then
+    bad "mode" "$TOKEN_FILE is mode $mode, expected 600"
+    note "refusing to rewrite $GIT_CREDENTIALS with a token whose file is not private"
+    exit 1
+  fi
   # A store-based credential helper reads ~/.git-credentials: rewrite it only when it exists,
   # so this script never creates a second credential store on a host that does not use one.
   if [ -f "$GIT_CREDENTIALS" ] && [ -s "$TOKEN_FILE" ]; then
diff --git a/tests/selftest.sh b/tests/selftest.sh
index cd6eae4..ceb2bb1 100755
--- a/tests/selftest.sh
+++ b/tests/selftest.sh
@@ -255,6 +255,96 @@ fi
 rm -rf "$tmpd"
 # END tailnet-address-gate
 
+# BEGIN github-app-refresh-gate
+# CF-320: this script used to print a FAIL mode row and then rewrite the git credential store
+# with that insecure token anyway, exit 0, and call the run "refreshed" on the strength of a
+# substring in the minter's stdout. The arms below run the REAL script against a stub minter,
+# each in its own mktemp -d: the script sources lib.sh from its own directory and execs
+# $HERE/github-app-token.py, so the stub replaces the copied minter beside it. No network, no
+# bunker, no real credential. Every arm asserts NAMED rows — a bootstrap crash that prints
+# "unbound variable", or a bare FAIL, satisfies none of them.
+gar_fixture() {  # gar_fixture <dir> — repo scripts tree plus a stub minter at <dir>/scripts
+  mkdir -p "$1/scripts"
+  cp -R "$HERE/scripts/." "$1/scripts/"
+  cat > "$1/scripts/github-app-token.py" <<'PY'
+import os, sys
+mode = os.environ.get("CF_STUB_MODE", "mint")
+if mode == "skip":
+    print("  SKIP  token — fixture token is young, still valid")
+    print("GITHUB APP TOKEN: SKIP — nothing to do")
+    sys.exit(0)
+dest = sys.argv[sys.argv.index("--out") + 1]
+with open(dest, "w", encoding="utf-8") as fh:
+    fh.write(os.environ.get("CF_STUB_TOKEN", "fixture-token") + "\n")
+os.chmod(dest, 0o644 if mode == "bad-mode" else 0o600)
+print("  PASS  token — written at mode %s (fixture minter)" % oct(os.stat(dest).st_mode & 0o777)[2:])
+print("GITHUB APP TOKEN: PASS — minted a 3600s fixture token")
+PY
+  printf 'GITHUB_APP_ID=1\nGITHUB_APP_INSTALLATION_ID=1\n' > "$1/github-app.env"
+  printf 'https://x-access-token:fixture-old\n' > "$1/git-credentials"
+  chmod 600 "$1/git-credentials"
+}
+# (a) An insecure mint must be a verdict, not a remark: non-zero exit, one named `FAIL mode` row,
+# no `PASS refresh` row, and the credential store left byte-identical.
+gar=$(mktemp -d)
+gar_fixture "$gar"
+cp -p "$gar/git-credentials" "$gar/git-credentials.pre"
+gar_out=$(env HOME="$gar" CF_STUB_MODE=bad-mode CF_STUB_TOKEN=insecure-fixture-token \
+  bash "$gar/scripts/github-app-refresh.sh" --env-file "$gar/github-app.env" \
+  --token-file "$gar/github.token" --git-credentials "$gar/git-credentials" 2>&1); gar_rc=$?
+gar_mode_rows=$(printf '%s\n' "$gar_out" | grep -Ec '^  FAIL  mode' || true)
+gar_refresh_rows=$(printf '%s\n' "$gar_out" | grep -Ec '^  PASS  refresh' || true)
+if [ "$gar_rc" -ne 0 ] && [ "$gar_mode_rows" = 1 ] && [ "$gar_refresh_rows" = 0 ] \
+  && cmp -s "$gar/git-credentials.pre" "$gar/git-credentials"; then
+  say "  PASS  insecure mint (mode 644) -> exit $gar_rc, one '^  FAIL  mode' row, no '^  PASS  refresh' row, credential store byte-identical"
+else
+  say "  FAIL  insecure mint still rewrote the credential store (exit $gar_rc, $gar_mode_rows mode row(s), $gar_refresh_rows refresh row(s))"; fails=$((fails+1))
+fi
+rm -rf "$gar"
+# (b) The clock-behind case: a token two hours old must be re-minted, and the re-mint must be
+# read off the FILE — mtime advanced and content digest changed — not off the minter's sentence.
+gar=$(mktemp -d)
+gar_fixture "$gar"
+printf 'stale-fixture-token\n' > "$gar/github.token"
+chmod 600 "$gar/github.token"
+touch -d '2 hours ago' "$gar/github.token"
+gar_pre_mtime=$(stat -c %Y "$gar/github.token")
+gar_pre_digest=$(sha256sum "$gar/github.token" | cut -d' ' -f1)
+gar_out=$(env HOME="$gar" CF_STUB_MODE=mint CF_STUB_TOKEN=fresh-fixture-token \
+  bash "$gar/scripts/github-app-refresh.sh" --env-file "$gar/github-app.env" \
+  --token-file "$gar/github.token" --git-credentials "$gar/git-credentials" 2>&1); gar_rc=$?
+gar_post_mtime=$(stat -c %Y "$gar/github.token")
+gar_post_digest=$(sha256sum "$gar/github.token" | cut -d' ' -f1)
+gar_refresh_rows=$(printf '%s\n' "$gar_out" | grep -Ec '^  PASS  refresh' || true)
+if [ "$gar_rc" -eq 0 ] && [ "$gar_post_mtime" -gt "$gar_pre_mtime" ] \
+  && [ "$gar_post_digest" != "$gar_pre_digest" ] && [ "$gar_refresh_rows" = 1 ]; then
+  say "  PASS  token mtime 2h old -> re-minted: mtime $gar_pre_mtime -> $gar_post_mtime, digest changed, one '^  PASS  refresh' row"
+else
+  say "  FAIL  a 2h-old token was not re-minted from a re-read (exit $gar_rc, mtime $gar_pre_mtime -> $gar_post_mtime, digest changed: $([ "$gar_post_digest" != "$gar_pre_digest" ] && echo yes || echo no))"; fails=$((fails+1))
+fi
+rm -rf "$gar"
+# (c) A fresh token whose minter reports a skip is a no-op: exit 0, neither file rewritten, and
+# the row says so. The file is re-read here too, so "no-op" is a measurement, not a quote.
+gar=$(mktemp -d)
+gar_fixture "$gar"
+printf 'still-valid-fixture-token\n' > "$gar/github.token"
+chmod 600 "$gar/github.token"
+cp -p "$gar/github.token" "$gar/github.token.pre"
+cp -p "$gar/git-credentials" "$gar/git-credentials.pre"
+gar_out=$(env HOME="$gar" CF_STUB_MODE=skip \
+  bash "$gar/scripts/github-app-refresh.sh" --env-file "$gar/github-app.env" \
+  --token-file "$gar/github.token" --git-credentials "$gar/git-credentials" 2>&1); gar_rc=$?
+gar_says_noop=no
+printf '%s\n' "$gar_out" | grep -Fq 'no-op' && gar_says_noop=yes
+if [ "$gar_rc" -eq 0 ] && cmp -s "$gar/github.token.pre" "$gar/github.token" \
+  && cmp -s "$gar/git-credentials.pre" "$gar/git-credentials" && [ "$gar_says_noop" = yes ]; then
+  say "  PASS  fresh token + minter skip -> exit 0, token and credential store byte-identical, the row says 'no-op'"
+else
+  say "  FAIL  a fresh token was not reported as a no-op (exit $gar_rc, no-op row: $gar_says_noop)"; fails=$((fails+1))
+fi
+rm -rf "$gar"
+# END github-app-refresh-gate
+
