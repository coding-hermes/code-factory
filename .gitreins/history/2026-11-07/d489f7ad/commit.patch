+@@ -46,6 +46,19 @@
+ SUPERVISION = ('deploy', 'deployment', 'systemd', 'contrib/systemd', 'ops', 'packaging')
+ DEPLOY_DOC = ('DEPLOY.md', 'docs/deploy.md', 'docs/deployment.md', 'RUNBOOK.md',
+               'docs/runbook.md', 'OPERATIONS.md', 'docs/operations.md')
++# The fleet's actual deploy-path convention is not the seven canonical spellings. A service records
++# its deploy path as `deploy/README.md` beside a unit directory, or `docs/runbook-<topic>.md`, or
++# `INSTALL.md`/`SETUP.md`; `exists_ci` matches whole BASENAMES, so none of those ever equals
++# `docs/runbook.md`, and the census reported "the deploy path is tribal" on 35 of 88 families whose
++# deploy path was fully documented (SCHED-GAP-16989). A basename carrying a deploy-path word with a
++# doc extension counts, depth-limited to the root and its two nearest levels, with build output and
++# harness bookkeeping pruned. A repo shipping no such artifact still reports P2/P3.
++DEPLOY_DOC_NAME_HINTS = ('deploy', 'runbook', 'operations', 'install', 'setup', 'provision')
++DEPLOY_DOC_DIR_HINTS = ('deploy', 'deployment', 'deployments')
++DEPLOY_DOC_EXTS = ('.md', '.rst', '.txt')
++DEPLOY_DOC_DEPTH = 2
++DEPLOY_DOC_SKIP_DIRS = ('.git', 'node_modules', 'venv', '.venv', 'dist', 'build', '__pycache__',
++                        'target', '.next', '.coding-hermes', '.gitreins')
+ BACKUP = ('backup', 'restore', 'snapshot')
+ # Artifact name substrings the backup arm accepts by BASENAME for doc/script extensions. `rel_hits`
+ # matches whole path COMPONENTS, so a real backup path recorded as `docs/backup-set.md` or
+@@ -230,6 +243,38 @@
+     return hits
+ 
+ 
++def deploy_doc_hits(root: str) -> list[str]:
++    """Deploy-path docs the seven canonical filenames miss (SCHED-GAP-16989).
++
++    `deploy/README.md`, `docs/runbook-<topic>.md`, `INSTALL.md` and `SETUP.md` are the fleet's
++    real convention. Matched by BASENAME hint plus a doc extension, depth-limited so a doc buried
++    in vendor or build output is not mistaken for the project's deploy path.
++    """
++    hits = []
++    root = os.path.realpath(root)
++    if not os.path.isdir(root):
++        return hits
++    for dirpath, dirnames, filenames in os.walk(root):
++        depth = dirpath[len(root):].count(os.sep)
++        if depth >= DEPLOY_DOC_DEPTH:
++            dirnames[:] = []
++        dirnames[:] = [d for d in dirnames if d not in DEPLOY_DOC_SKIP_DIRS]
++        for f in filenames:
++            low = f.lower()
++            if not low.endswith(DEPLOY_DOC_EXTS):
++                continue
++            p = os.path.relpath(os.path.join(dirpath, f), root)
++            # A doc sitting directly in a deploy directory is the deploy doc whatever it is
++            # called (`deploy/README.md` is the fleet convention); otherwise the name must carry
++            # a deploy-path word.
++            in_deploy_dir = any(part.lower() in DEPLOY_DOC_DIR_HINTS
++                                for part in p.replace(os.sep, '/').split('/')[:-1])
++            if in_deploy_dir or any(h in low for h in DEPLOY_DOC_NAME_HINTS):
++                if p not in hits:
++                    hits.append(p)
++    return sorted(hits)
++
++
