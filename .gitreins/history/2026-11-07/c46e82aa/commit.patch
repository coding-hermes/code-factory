+
+    def tearDown(self) -> None:
+        self._tmp.cleanup()
+
+    def apply(
+        self, *extra: object, sha: str | None = None
+    ) -> subprocess.CompletedProcess:
+        return py(
+            "install-node.sh",
+            "--apply",
+            "--root",
+            self.install_root,
+            "--tarball",
+            self.archive,
+            "--sha256",
+            sha or self.digest,
+            *extra,
+        )
+
+    def test_check_before_apply_is_red(self) -> None:
