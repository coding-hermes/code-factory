+
+
+def b64(text):
+    return base64.b64encode(text.encode("utf-8")).decode("ascii")
+
+
+def text_only_digest(text):
+    """The pre-CF-275 definition: sha256 over the directive text alone."""
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
