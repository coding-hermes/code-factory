diff --git a/scripts/node_seed_drift.py b/scripts/node_seed_drift.py
index abb1e13..85cf74b 100644
--- a/scripts/node_seed_drift.py
+++ b/scripts/node_seed_drift.py
@@ -38,6 +38,14 @@ Usage:
   scripts/node_seed_drift.py --agent cf-node --server bunker-las-03 --strict-seed
   scripts/node_seed_drift.py --home /tmp/fixture-home
   scripts/node_seed_drift.py --home /tmp/fixture-home --json
+  scripts/node_seed_drift.py --strict-note
+
+--strict-note prints just the --strict-seed parenthetical and exits 0. It exists
+because this file owns that sentence and scripts/verify-node.sh needs it for a
+branch this probe never reaches: a record that does not parse is EXIT_UNMEASURABLE
+under --strict-seed too, so the verifier writes that FAIL row itself. It used to
+re-type the sentence there and the copy dropped the word `seed`; asking the owner
+for the string is what keeps the two from drifting apart (QA-CODE-FACTORY-2).
 
 stdlib only.
 """
@@ -67,6 +75,18 @@ RECORD_REL = os.path.join(".hermes", "seed-applied.json")
 # --json for the rest.
 MAX_SHOWN = 20
 
+# The parenthetical that says what --strict-seed refuses. It lives HERE because
+# this file owns the verdict: on exit 1 scripts/verify-node.sh quotes the row
+# built from it verbatim, but that verifier's exit-3 branch cannot quote
+# anything — a record this probe cannot read (0 bytes, unparseable) is
+# EXIT_UNMEASURABLE whatever --strict-seed says, so no strict FAIL row is ever
+# printed for it. The verifier used to re-type the sentence for that branch, and
+# the copy lost the word `seed` (`unknown is not a pass`), so the selftest arm
+# that greps the canonical phrase went red whenever the seed could not be
+# measured on an otherwise identical tree. The verifier now asks for this string
+# with --strict-note instead of keeping a second copy (QA-CODE-FACTORY-2).
+STRICT_NOTE = "(--strict-seed: an unknown seed is not a pass)"
+
 # The sibling seeder: the same script provisioning applies on the node, so the
 # verdict is the instrument's own, not a wrapper's reimplementation.
 SEED_SIBLING_NAME = "node_seed.py"
@@ -237,8 +257,7 @@ def finding_absent(record: str, strict: bool) -> dict:
             "exit_code": EXIT_DRIFT,
             "reason": "no seed record at %s" % record,
             "rows": [
-                "  FAIL  seed_drift — no seed record at %s (--strict-seed: an unknown seed is not a pass)"
-                % record
+                "  FAIL  seed_drift — no seed record at %s %s" % (record, STRICT_NOTE)
             ],
             "result": "RESULT: FAIL (no seed record at %s)" % record,
         }
@@ -503,6 +522,11 @@ def main(argv: Optional[list] = None) -> int:
         default=180,
         help="exec timeout in seconds; the bunker exec stream dies at 300 (default 180)",
     )
+    ap.add_argument(
+        "--strict-note",
+        action="store_true",
+        help="print only the --strict-seed parenthetical on stdout and exit (its one source)",
+    )
     ap.add_argument(
         "--json",
         action="store_true",
@@ -510,6 +534,14 @@ def main(argv: Optional[list] = None) -> int:
     )
     opts = ap.parse_args(argv)
 
+    # The interface scripts/verify-node.sh captures: the sentence, and nothing else. No probe mode is
+    # needed for it — the wording is a constant, not a measurement — so this answers before the mode
+    # checks below and always exits 0. A caller that cannot read it must say so in its own row rather
+    # than fall back to a second copy of the sentence, which is exactly how the copy drifted.
+    if opts.strict_note:
+        print(STRICT_NOTE)
+        return EXIT_OK
+
     def usage_error(message: str) -> int:
         print(message, file=sys.stderr)
         print("RESULT: FAIL (usage: %s)" % message)
diff --git a/scripts/verify-node.sh b/scripts/verify-node.sh
index 84e33ce..ac62fd7 100755
--- a/scripts/verify-node.sh
+++ b/scripts/verify-node.sh
@@ -203,6 +203,22 @@ else
   seed_rows=$(mktemp); seed_json=$(mktemp)
   strict_seed_argv=""
   [ "${STRICT_SEED:-0}" -eq 1 ] && strict_seed_argv="--strict-seed"
+  # The strict sentence belongs to the CHECKER, not to this script (QA-CODE-FACTORY-2). On exit 1 the
+  # row below quotes node_seed_drift.py verbatim, so that path is safe by construction; the exit-3
+  # branch is not — a record the checker cannot read (0 bytes, unparseable) is EXIT_UNMEASURABLE
+  # whatever --strict-seed says, so this verifier has to write that FAIL row itself, and the wording
+  # re-typed here had drifted to `unknown is not a pass` (one word short). The selftest arm that greps
+  # the canonical phrase therefore went red whenever the seed leg could not be measured on an
+  # otherwise identical tree — measured 2026-11-06: PASS, PASS, FAIL, PASS across four guard runs of
+  # one hour. Ask the owning file for its sentence instead of keeping a second copy.
+  strict_seed_note=""
+  if [ "${STRICT_SEED:-0}" -eq 1 ]; then
+    strict_seed_note=$(python3 -B "$SEEDCHK" --strict-note 2>/dev/null)
+    # No fallback copy of the wording on purpose: if the owner cannot speak, the row says that rather
+    # than printing a sentence that no file owns — a fallback IS the drift this removes.
+    [ -z "$strict_seed_note" ] &&
+      strict_seed_note="(the checker did not answer --strict-note — its strict wording is unavailable)"
+  fi
   python3 -B "$SEEDCHK" --agent "$AGENT" --server "$SERVER" $strict_seed_argv --json >"$seed_json" 2>"$seed_rows"
   src=$?
   case "$src" in
@@ -216,7 +232,7 @@ else
       detail=$(grep -E '^  WARN  seed_drift — ' "$seed_rows" | sed -e 's/^  WARN  seed_drift — //' | head -1)
       [ -z "$detail" ] && detail=$(grep -E '^RESULT: ' "$seed_rows" | head -1 | sed -e 's/^RESULT: //')
       if [ "${STRICT_SEED:-0}" -eq 1 ]; then
-        bad "seed_drift" "${detail:-unmeasurable} (--strict-seed: unknown is not a pass)"
+        bad "seed_drift" "${detail:-unmeasurable}${strict_seed_note:+ $strict_seed_note}"
       else
         warn "seed_drift" "${detail:-unmeasurable} — the seed could not be measured; pass --strict-seed to refuse it"
         # A WARN row is not a pass and not a FAIL: the seed was never read, so VERIFY: PASS here
diff --git a/tests/selftest.sh b/tests/selftest.sh
index 773fa5f..71f548a 100755
--- a/tests/selftest.sh
+++ b/tests/selftest.sh
@@ -4132,6 +4132,62 @@ else
   printf '%s\n' "$out" | sed 's/^/    | /'
 fi
 
+# one owning source (QA-CODE-FACTORY-2): the sentence may live in the checker, never again in the
+# verifier — a second copy is what drifted. Count the tracked scripts, not the fixtures.
+owners=$(grep -rlF --include='*.py' --include='*.sh' 'an unknown seed is not a pass' "$HERE/scripts" 2>/dev/null \
+  | sed -e "s|^$HERE/scripts/||" | paste -sd ',' -)
+if [ "$owners" = "node_seed_drift.py" ]; then
+  say "  PASS  the strict-seed sentence has one owning source: scripts/$owners"
+else
+  say "  FAIL  the strict-seed sentence is not owned by exactly one file (found in: ${owners:-nowhere})"
+  fails=$((fails+1))
+fi
+
+# the OTHER strict branch of the seed leg: an ABSENT record reaches the checker's own exit 1, so the
+# verifier quotes the checker's row and the wording is the checker's by construction (arm above). A
+# record that does not parse (here: 0 bytes) is EXIT_UNMEASURABLE = 3 whatever --strict-seed says, so
+# the verifier writes that FAIL row ITSELF — and the sentence re-typed there had lost the word `seed`
+# (`unknown is not a pass`), which made this suite's phrase arm depend on WHICH branch the seed leg
+# happened to take. `does not parse` only appears in the checker's WARN detail, so asserting it also
+# proves the run took exit 3 and not exit 1: this arm drives the divergent branch on purpose.
+: > "$vn_rec"
+out=$(vn_run "$vn/tree" --strict-seed); rc=$?
+if [ "$rc" -eq 1 ] && printf '%s\n' "$out" | grep -Fxq 'VERIFY: FAIL (1)' \
+  && printf '%s\n' "$out" | grep -Fq '  FAIL  seed_drift — ' \
+  && printf '%s\n' "$out" | grep -Fq 'does not parse' \
+  && printf '%s\n' "$out" | grep -Fq 'an unknown seed is not a pass'; then
+  say "  PASS  a 0-byte record under --strict-seed -> exit $rc, FAIL via the verifier's exit-3 branch with the checker's sentence"
+else
+  say "  FAIL  the exit-3 strict branch lost the checker's sentence (exit $rc)"; fails=$((fails+1))
+  printf '%s\n' "$out" | sed 's/^/    | /'
+fi
+
+# seeded negative for the arm above: mutate the ONE owning sentence in a scratch copy of the tree and
+# the same run must lose the phrase. Without it the arm could be greening on a sentence that came
+# from somewhere else and nobody would know the instrument was blind.
+vn_mut="$vn/mutant"
+mkdir -p "$vn_mut"
+cp -r "$vn/tree/scripts" "$vn_mut/scripts"
+sed -e 's/an unknown seed is not a pass/an unknown is not a pass/' \
+  "$vn/tree/scripts/node_seed_drift.py" > "$vn_mut/scripts/node_seed_drift.py"
+if cmp -s "$vn/tree/scripts/node_seed_drift.py" "$vn_mut/scripts/node_seed_drift.py"; then
+  say "  FAIL  the seeded negative mutated nothing — the arm above would prove nothing"; fails=$((fails+1))
+else
+  : > "$vn_rec"
+  out=$(vn_run "$vn_mut" --strict-seed); rc=$?
+  if [ "$rc" -eq 1 ] && printf '%s\n' "$out" | grep -Fxq 'VERIFY: FAIL (1)' \
+    && printf '%s\n' "$out" | grep -Fq '  FAIL  seed_drift — ' \
+    && ! printf '%s\n' "$out" | grep -Fq 'an unknown seed is not a pass'; then
+    say "  PASS  a scratch tree whose single source lost the phrase -> the arm above goes red (exit $rc, phrase absent)"
+  else
+    say "  FAIL  the phrase arm cannot fail: a mutated source still greened it (exit $rc)"; fails=$((fails+1))
+    printf '%s\n' "$out" | sed 's/^/    | /'
+  fi
+fi
+# the record is restored here because the arms below (missing seeder, then the green re-run) expect a
+# readable one; the sibling arms above restore the same way, from the pristine copy.
+cp "$vn/good-record.json" "$vn_rec"
+
 # the seeder itself gone: nothing could stage a check, and that is a named FAIL, not a warning.
 mv "$vn/tree/scripts/node_seed_drift.py" "$vn/node_seed_drift.py.bak"
 out=$(vn_run "$vn/tree"); rc=$?
